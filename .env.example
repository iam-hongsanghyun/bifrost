# Where the Ragnarok engine is. Bifrost holds no model of its own.
RAGNAROK_API_BASE=http://127.0.0.1:8000

# The Ragnarok session the agent and the embedded Ragnarok UI BOTH act on.
# They must match, or the user watches a different model than the agent edits.
RAGNAROK_SESSION_ID=default

# Conversation groups and their project packages.
BIFROST_DATA_DIR=

# Ceiling on a single Ragnarok call. Solves go to Ragnarok's queue and are
# polled, so nothing here should be long-running.
BIFROST_REQUEST_TIMEOUT_S=120

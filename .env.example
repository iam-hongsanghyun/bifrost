# Bifrost's own ports. Deliberately not 5173 (collides with any other Vite
# project) or 8000-something (collides with Ragnarok). The Vite proxy target is
# derived from BIFROST_API_PORT, so overriding it moves both halves together.
BIFROST_API_PORT=8770
BIFROST_UI_PORT=8771

# Where the Ragnarok engine is. Bifrost holds no model of its own. 8772, not
# Ragnarok's own 8000, so a Ragnarok you run by hand can keep that port.
RAGNAROK_API_BASE=http://127.0.0.1:8772

# The Ragnarok session the agent and the embedded Ragnarok UI BOTH act on.
# They must match, or the user watches a different model than the agent edits.
RAGNAROK_SESSION_ID=default

# Conversation groups and their project packages.
BIFROST_DATA_DIR=

# Ceiling on a single Ragnarok call. Solves go to Ragnarok's queue and are
# polled, so nothing here should be long-running.
BIFROST_REQUEST_TIMEOUT_S=120

# Optional: where the agent's MCP subprocess finds the engine. Defaults to
# RAGNAROK_API_BASE; set it only if the two must differ.
RAGNAROK_AGENT_API_BASE=

# Charts and the State panel
BIFROST_CHART_MAX_POINTS=10000   # points per series a show_chart payload keeps before thinning
BIFROST_CHART_MAX_CELLS=250000   # series x points the browser draws; above this a chart is thinned
BIFROST_TABLE_MAX_ROWS=20000     # rows the State panel's table view fetches per sheet
